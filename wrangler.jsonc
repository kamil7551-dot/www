{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "www",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    // Sites live at <slug>.<PLATFORM_DOMAIN>. Locally: http://demo.localhost:8787
    "PLATFORM_DOMAIN": "localhost"
  },
  "images": { "binding": "IMAGES" },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "www-media" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "www-db",
      // Placeholder for local development. Replaced with the real id at first deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
